mainmenu "Orangelink"

config ORANGELINK_LOG_LEVEL
	int "Orangelink log level"
	default 3
	range 0 4
	help
	  Log level for Orangelink modules: 0=off 1=err 2=wrn 3=inf 4=dbg.

choice ORANGELINK_RFM69_VARIANT
	prompt "RFM69 module variant"
	default ORANGELINK_RFM69_W
	help
	  Which power amplifier the module bonds to its antenna. This is not
	  detectable in software -- RFM69W and RFM69HW/HCW both report
	  REG_VERSION 0x24 -- and choosing wrong means no RF output at all.

config ORANGELINK_RFM69_W
	bool "RFM69W (PA0 bonded, up to +13 dBm)"
	help
	  Plain RFM69W. PA0 drives the antenna; PA1 and PA2 are not connected.
	  This is what the legacy Orangelink hardware used.

config ORANGELINK_RFM69_HW
	bool "RFM69HW / RFM69HCW (PA1+PA2 bonded, up to +17 dBm)"
	help
	  High-power variant. PA0 is NOT bonded to the antenna, so leaving the
	  register at its PA0-only reset default transmits nothing. Most 915 MHz
	  breakout boards sold today are HCW.

endchoice

choice ORANGELINK_RFM69_HW_PA
	prompt "PA stage to drive on RFM69HW/HCW"
	depends on ORANGELINK_RFM69_HW
	default ORANGELINK_RFM69_HW_PA1_PA2
	help
	  Which PA_BOOST stage to enable. Both drive the same pin, so this does
	  not change the antenna path or the module's matching network -- only
	  how much bias current is burned to reach a given output power.

config ORANGELINK_RFM69_HW_PA1
	bool "PA1 only (-2 to +13 dBm)"
	help
	  One stage. Pout = -18 + OutputPower -- the same law the RFM69W's PA0
	  uses, so this reproduces the legacy Orangelink's operating point on the
	  pin an HCW actually bonds to the antenna.

config ORANGELINK_RFM69_HW_PA1_PA2
	bool "PA1 + PA2 (+2 to +17 dBm)"
	help
	  Two stages. Pout = -14 + OutputPower. Required above +13 dBm, but it
	  carries roughly 60 mA of fixed bias whatever the output level, so below
	  +13 dBm it costs current for nothing. Datasheet Table 10.

endchoice

config ORANGELINK_RFM69_TX_DBM
	int "RFM69 output power (dBm)"
	default 13
	range -18 17
	help
	  Target output power at the antenna. The OutputPower field of RegPaLevel
	  is derived from this and the PA stage above, so switching stage does not
	  change what leaves the antenna -- only the current it costs.

config ORANGELINK_RFM69_LISTEN
	bool "Duty-cycle the receiver with RFM69 Listen Mode"
	default n
	help
	  AndroidAPS chooses how LONG we listen -- the timeout arrives in the
	  command -- but not what the radio does during that window. By default
	  subg_get_pkt() holds the receiver on continuously at ~16 mA for the whole
	  window, and measured against real AAPS traffic that is ~60% of all radio
	  energy.

	  Listen Mode alternates idle and receive in hardware and only wakes the
	  host on a hit, which is invisible to AAPS: same command, same window,
	  same reply. The constraint is that the idle half must be shorter than the
	  incoming preamble, or the receiver sleeps through it.

	  A HackRF capture of a live exchange measured the pump's reply preamble at
	  >= 91 bits (~5.55 ms), against the 16 bytes (7.81 ms) we transmit. The
	  defaults below leave margin against that, but it is one pump on one bench
	  -- sweep ORANGELINK_RFM69_LISTEN_IDLE_US upward and watch the reply rate
	  before trusting it. See MIGRATION_NOTES.md section 21.

config ORANGELINK_RFM69_LISTEN_IDLE_US
	int "Listen Mode idle duration (us)"
	depends on ORANGELINK_RFM69_LISTEN
	default 3264
	range 64 16320
	help
	  Rounded down to a multiple of 64 us. Must stay comfortably below the
	  pump's reply preamble (~5550 us measured) with room for receiver wake-up
	  and bit sync, or replies are missed.

config ORANGELINK_RFM69_LISTEN_RX_US
	int "Listen Mode receive duration (us)"
	depends on ORANGELINK_RFM69_LISTEN
	default 1472
	range 64 16320
	help
	  Rounded down to a multiple of 64 us. Includes receiver start-up, so this
	  cannot be trimmed to nothing -- too short and the RSSI decision is made
	  before the front end has settled.

config ORANGELINK_RFM69_LISTEN_RSSI_THRESH
	int "RSSI threshold while listening (RegRssiThresh, -dBm x 2)"
	depends on ORANGELINK_RFM69_LISTEN
	default 180
	range 0 255
	help
	  180 is -90 dBm. Acceptance uses RSSI alone rather than RSSI plus sync
	  match, because requiring the sync word would mean holding the receiver on
	  across the whole preamble and sync -- which is the cost being avoided.
	  The normal threshold of 228 (-114 dBm) is far too sensitive for that and
	  would wake on noise every cycle. Measured pump replies land at -60 to
	  -70 dBm, so there is ample margin.

config ORANGELINK_TX_LEGACY_TRUNCATE
	bool "Transmit like the legacy firmware (fixed 255-byte frame, truncated)"
	default n
	help
	  Reproduces a 255-byte fixed frame truncated by forcing STANDBY once the
	  FIFO has drained, for diagnosing interoperability.

	  NOTE: this is NOT what the legacy firmware did, despite what this help
	  text claimed until it was checked. Subg_SendPkt() calls
	  Rf69_SetPayloadLen(len + 1) once per burst, so legacy sent correctly sized
	  frames too. Kept only as a diagnostic knob.

menu "Status LED and battery"

config ORANGELINK_LED
	bool "Onboard RGB status LED"
	default y
	help
	  Drive the XIAO's onboard RGB LED as a battery-charge indicator: a 30 ms
	  flash every 10 s, green / yellow / red by state of charge.

	  NOTE this is not what the legacy firmware showed. Legacy used its two LEDs
	  for BLE state (yellow when connected, red when advertising or
	  disconnected) and red-steady only for low battery. That indication is
	  deliberately not ported -- there is one RGB device here and charge was
	  judged the more useful thing to show. See MIGRATION_NOTES.md.

config ORANGELINK_BATTERY
	bool "Battery monitor (1S LiPo on AIN7)"
	default y
	select ADC
	help
	  Periodically sample the cell through the XIAO's onboard divider and, when
	  ORANGELINK_LED is set, colour the status LED by charge.

if ORANGELINK_BATTERY

config ORANGELINK_BATTERY_OUTPUT_OHMS
	int "Divider low-side resistance (ohms)"
	default 510000
	help
	  Lower leg of the XIAO's onboard battery divider, P0.31 to ground.

config ORANGELINK_BATTERY_FULL_OHMS
	int "Divider total resistance (ohms), calibrated"
	default 1531215
	help
	  Cell voltage is the measured pin voltage scaled by FULL_OHMS /
	  OUTPUT_OHMS.

	  This is a CALIBRATION HANDLE, not strictly a resistance: it absorbs
	  resistor tolerance and ADC gain/offset error as well as the nominal
	  divider ratio, so the calibrated value is expected to deviate from the
	  nominal part values.

	  CALIBRATED on the bench unit: pin read 1259 mV where a meter measured
	  3.78 V across the cell, giving a ratio of 3.0024 against the nominal
	  2.9608 for 1M / 510k -- 1.4% high, consistent with 1% resistors plus ADC
	  error. That 1.4% mattered: it moved the reading from 19% (red) to 32%
	  (yellow).

	  Recalibrate per board. The module logs raw count, pin mV and derived cell
	  mV once at startup; measure the cell and scale this value by
	  measured / derived.

config ORANGELINK_BATTERY_GREEN_PERCENT
	int "Green at or above this percent"
	default 60
	range 0 100

config ORANGELINK_BATTERY_YELLOW_PERCENT
	int "Yellow at or above this percent, red below"
	default 20
	range 0 100

config ORANGELINK_BATTERY_FAST_CHARGE
	bool "Select the 100 mA charge current (P0.13 driven low)"
	default y
	help
	  The XIAO's charger current is selected by P0.13: high-impedance input
	  gives ~50 mA, output driven low gives ~100 mA. Both apply during the
	  constant-current phase only; current tapers as the cell fills.

	  CHECK THE CELL FIRST. 100 mA is 1C for a 100 mAh pack and 2C for a 50 mAh
	  one, which is above what small cells are rated to accept. Leave this off
	  for anything under roughly 200 mAh.

	  The bench unit runs an 1800 mAh cell, where 100 mA is 0.056C -- so far
	  below any limit that the only real consideration is charge time, and
	  100 mA is the XIAO charger's maximum. Do not turn this off on that unit:
	  50 mA would take about 30 hours from half charge.

config ORANGELINK_BATTERY_HYSTERESIS
	int "Percent a reading must recover before the colour rises"
	default 3
	range 0 25
	help
	  Stops the colour flapping when the cell rests on a threshold, which it
	  will under a bursty transmit load.

endif # ORANGELINK_BATTERY

endmenu

source "Kconfig.zephyr"
